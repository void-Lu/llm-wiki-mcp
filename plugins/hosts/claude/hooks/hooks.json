{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--no-python-downloads",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/session_hook.py",
              "claude"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
